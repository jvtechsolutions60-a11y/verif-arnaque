{
  "name": "Vérif'Arnaque, par JVTECH Solutions",
  "short_name": "Vérif'Arnaque",
  "description": "Vérifiez un SMS, un mail, un lien ou une capture d'écran suspects. L'analyse se fait sur votre appareil, rien n'est envoyé.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f5f9",
  "theme_color": "#0f3561",
  "icons": [
    { "src": "logo/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "logo/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "logo/icone-masquable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "lien",
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
